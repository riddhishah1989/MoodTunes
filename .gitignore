# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
app/build/

# Local configuration file (sdk path, signing configs, etc.)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# MacOS
.DS_Store

# Windows
Thumbs.db

# Keystore files — NEVER commit these
*.jks
*.keystore

# Google services — contains API keys, do not commit
google-services.json

# Signing configs
signing.properties

# Secrets / env
*.env
secrets.properties

# Claude Code local config
.claude/
